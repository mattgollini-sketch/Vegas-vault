# Generate with: npm run generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# A contact address the push service can reach you at if there's a problem
VAPID_SUBJECT=mailto:you@example.com

# Hour of the day (0-23) the daily notification fires, in Pacific time (Las Vegas)
NOTIFY_HOUR=9

# Secret required to trigger POST /api/send-now. Leave blank to disable that route.
ADMIN_SECRET=

# Where the SQLite database lives. On Railway, point this at the attached volume,
# for example /data/vegas-vault.sqlite. If you set DATA_DIR instead, the file is
# DATA_DIR/vegas-vault.sqlite. Local default is ./data/vegas-vault.sqlite.
SQLITE_PATH=
DATA_DIR=

# Password hashing cost. 12 is the default. Tests use 4.
BCRYPT_COST=12

# How many login/signup attempts each IP gets per window (default 10 per 15 minutes).
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=900000

PORT=3000
NODE_ENV=production

# --- Affiliate links -------------------------------------------------------
# Leave every ID blank to keep ordinary search links. Do not commit real IDs.
# Paste only the ID your affiliate dashboard gives you, not a full URL.
# The disclosure line appears by itself once at least one ID is set.
#
# Booking.com Affiliate Partner Centre → your aid
BOOKING_AFFILIATE_ID=
# Expedia affiliate program → your affcid
EXPEDIA_AFFILIATE_ID=
# Viator Partner Program → your pid
VIATOR_PARTNER_ID=
# GetYourGuide Partner Hub → your partner_id
GETYOURGUIDE_PARTNER_ID=
# Ticketmaster via Impact. Both are required; if either is blank the link stays a normal Ticketmaster search.
# The link becomes https://ticketmaster.evyy.net/c/PUBLISHER_ID/AD_ID/<encoded search url>
TICKETMASTER_IMPACT_PUBLISHER_ID=
TICKETMASTER_IMPACT_AD_ID=
# OpenTable partner ref. Resy stays a plain search link.
OPENTABLE_REF=

# --- Group Vault unlock (Stripe Checkout) ----------------------------------
# Solo trips stay free. Invites, polls, and expense splits for more than one
# person need a one-time payment per Vault.
# If any of the three STRIPE_ variables is blank, group tools stay unlocked
# and the server prints a dev-mode warning. That is the local default.
#
# Use a Stripe sandbox (or test mode) while you try this. Test keys start with
# sk_test_ or rk_test_. A restricted key (rk_) is a good fit: paste it in
# STRIPE_SECRET_KEY. It needs permission to create Checkout Sessions.
# Create a one-time Price in that same sandbox and paste its price_... id.
# The amount charged is whatever that Price says. GROUP_UNLOCK_PRICE is only
# the number the app shows (default 7.99). Make the two match.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
GROUP_UNLOCK_PRICE=7.99
