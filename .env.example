# Generate with: npm run generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# A contact address the push service can reach you at if there's a problem
VAPID_SUBJECT=mailto:you@example.com

# Hour of the day (0-23) the daily notification fires, in Pacific time (Las Vegas)
NOTIFY_HOUR=9

# Secret required to trigger POST /api/send-now. Leave blank to disable that route.
ADMIN_SECRET=

# Where the SQLite database lives. On Railway, point this at the attached volume,
# for example /data/vegas-vault.sqlite. If you set DATA_DIR instead, the file is
# DATA_DIR/vegas-vault.sqlite. Local default is ./data/vegas-vault.sqlite.
SQLITE_PATH=
DATA_DIR=

# Password hashing cost. 12 is the default. Tests use 4.
BCRYPT_COST=12

# How many login/signup attempts each IP gets per window (default 10 per 15 minutes).
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=900000

PORT=3000
NODE_ENV=production
